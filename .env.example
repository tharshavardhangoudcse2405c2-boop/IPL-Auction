# ==============================================================================
# Real Auction 26 — Environment Variables
# Copy to .env for local development. Never commit real secrets to GitHub.
# ==============================================================================

# --- Core Server & AI Analysis ------------------------------------------------
# Public URL of your deployed service (e.g. https://real-auction-26.onrender.com)
APP_URL="http://localhost:3000"

# Google Gemini API key for post-auction AI Winner Analysis (optional if AI not used)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Authentication & Persistent PostgreSQL Sessions (Required for Login) -----
# Render PostgreSQL Internal Database URL (postgresql://USER:PASSWORD@HOST/DB_NAME)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/real_auction_26"

# Random cryptographic signing key (minimum 32 random characters).
# On Render, render.yaml generates this automatically via generateValue: true.
AUTH_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"

# --- Email OTP via Resend (Required only for Email Login) ---------------------
# API key created in your Resend dashboard
RESEND_API_KEY=""

# Verified sender address on your Resend domain, e.g.:
# EMAIL_FROM="Real Auction 26 <auth@yourdomain.com>"
EMAIL_FROM=""

# --- Phone SMS OTP via Twilio (Required only for SMS Login) -------------------
# Found on your Twilio Console Dashboard (starts with AC...)
TWILIO_ACCOUNT_SID=""

# Found on your Twilio Console Dashboard
TWILIO_AUTH_TOKEN=""

# Configure EITHER a Twilio phone number in E.164 format (+15551234567)
# OR a Twilio Messaging Service SID (starts with MG...).
TWILIO_FROM_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""
